# python scripts/gen_env.py ile güvenli değerler üretilir.
# Prod varsayılanları: API https://momenz.onrender.com · Web https://momenz.vercel.app
# Yerel geliştirme: environment=dev, cookie_secure=false, trusted_hosts=localhost,127.0.0.1
MOMENZ_ENVIRONMENT=prod
MOMENZ_API_BASE_URL=https://momenz.onrender.com
MOMENZ_JWT_SECRET=buraya-64-karakter-rastgele-deger
MOMENZ_COOKIE_SECURE=true
MOMENZ_TRUSTED_HOSTS=momenz.onrender.com,localhost
MOMENZ_CORS_ORIGINS=https://momenz.vercel.app
MOMENZ_WEB_BASE_URL=https://momenz.vercel.app

MOMENZ_D1_ACCOUNT_ID=
MOMENZ_D1_DATABASE_ID=
MOMENZ_D1_API_TOKEN=

MOMENZ_GOOGLE_DRIVE_API_KEY=
MOMENZ_GOOGLE_SERVICE_ACCOUNT_JSON=

# Yalnızca "şifremi unuttum" için kullanılır.
# Render SMTP portlarını bloklar; Apps Script Gmail köprüsü HTTPS ile çalışır.
# Kurulum: scripts/apps_script_mail.gs
MOMENZ_MAIL_WEBHOOK_URL=
MOMENZ_MAIL_WEBHOOK_SECRET=
MOMENZ_MAIL_FROM=Momenz <no-reply@mome.nz>
MOMENZ_MAIL_RESET_URL=https://momenz.vercel.app/sifre-sifirla?token={token}
